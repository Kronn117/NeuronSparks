# Neuron Sparks Environment Configuration
# Copy this file to .env and fill in the values

# App Environment
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_DEBUG=true

# API Configuration (for future cloud sync)
EXPO_PUBLIC_API_URL=https://api.neuronsparks.local
EXPO_PUBLIC_API_TIMEOUT=30000

# Firebase Configuration (Optional - Phase 3)
# EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Analytics Configuration (Optional)
# EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Sentry Configuration (Optional - Error tracking)
# EXPO_PUBLIC_SENTRY_DSN=

# Feature Flags
EXPO_PUBLIC_ENABLE_VOICE_NOTES=false
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=false
EXPO_PUBLIC_ENABLE_AI_FEATURES=false
